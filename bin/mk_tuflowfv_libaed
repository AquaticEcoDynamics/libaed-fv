#!/bin/bash

if [ "$MYPATH" = "" ] ; then
  MYPATH='/usr/local/lib/libaed-tfv'
fi
if [ "$TFV_VRS" = "" ] ; then
  export TFV_VRS=`cat tuflowfv-version`
fi

cat << EOF
#!/bin/bash

export AED_DIR=\$(dirname \$(realpath "\$0"))
EXTRA_PATH=\$(dirname \$AED_DIR)/\$EXTRA_PATH/tuflowfv-${TFV_VRS}
export LD_LIBRARY_PATH=\$AED_DIR/libaed-tfv:\$EXTRA_PATH
ulimit -s unlimited > /dev/null
/usr/local/bin/tuflowfv-${TFV_VRS}/tuflowfv-${TFV_VRS} "\$@"
EOF
